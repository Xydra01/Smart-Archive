# Copy to backend/.env and adjust as needed. All keys are optional;
# anything you omit falls back to the defaults in backend/app/config.py.

# --- Ollama / models ---
ARCHIVE_OLLAMA_HOST=http://localhost:11434
# Any local Ollama chat model works. Default is llama3.2:3b (fast, ~2GB).
# See the README "Choosing a model" section for picks by hardware.
ARCHIVE_LLM_MODEL=llama3.2:3b
ARCHIVE_EMBED_MODEL=nomic-embed-text
# Let reasoning ("thinking") models emit their chain-of-thought. Off by default
# so tokens go to the answer instead of hidden reasoning.
ARCHIVE_LLM_THINK=false

# --- Chunking ---
ARCHIVE_CHUNK_TOKENS=512
ARCHIVE_CHUNK_OVERLAP_TOKENS=64

# --- Retrieval ---
ARCHIVE_SEMANTIC_TOP_K=20
ARCHIVE_KEYWORD_TOP_K=20
ARCHIVE_FUSION_TOP_K=8
# Max number of sources a single scoped query (ad-hoc selection or group) may target.
ARCHIVE_MAX_SELECTION=10000

# --- Vision ingest (opt-in; slow, so OFF by default) ---
# When enabled, a local vision-language model reads charts, diagrams, figures,
# illustrations, and image-only tables (including figures on scanned pages)
# during indexing and turns them into searchable text. This is front-loaded
# work: slow at ingest, free at query time, and skipped for unchanged files.
# While an index job runs, querying is paused (hard-blocked) so the vision
# model and the chat model never contend for RAM on an 8GB machine.
# Requires the model to be pulled first: `ollama pull qwen2.5vl:3b`.
ARCHIVE_VISION_ENABLED=false
ARCHIVE_VISION_MODEL=qwen2.5vl:3b
# Per-visual wall-clock timeout in seconds (a slow/huge image is skipped, not fatal).
ARCHIVE_VISION_TIMEOUT_S=120
# Caps bounding worst-case ingest time on image-heavy documents.
ARCHIVE_VISION_MAX_IMAGES_PER_PAGE=6
ARCHIVE_VISION_MAX_IMAGES_PER_FILE=400
# Ignore images below this pixel area (width*height). Higher skips more small
# decorative images (icons, rules) — fewer VLM calls. ~16384 = 128x128.
ARCHIVE_VISION_MIN_IMAGE_PIXELS=16384
# DPI used when rendering a whole page to read figures on scanned/image-only pages.
ARCHIVE_VISION_RENDER_DPI=150
# --- Speed knobs (cut ingest time with little information loss) ---
# Keep the vision model resident between images so a long ingest doesn't pay
# repeated ~15-20s reloads. Ollama duration string; "-1" = never unload.
ARCHIVE_VISION_KEEP_ALIVE=30m
# Smaller context + capped output per image = faster calls (vision text is short).
ARCHIVE_VISION_NUM_CTX=2048
ARCHIVE_VISION_NUM_PREDICT=384
# OCR whole scanned/image-only pages. Set false if your PDFs aren't scanned
# (avoids a full-page VLM call on near-empty pages).
ARCHIVE_VISION_OCR_SCANNED_PAGES=true

# --- Generation (lower num_ctx if you hit memory pressure on 8GB RAM) ---
ARCHIVE_LLM_NUM_CTX=4096
ARCHIVE_LLM_TEMPERATURE=0.2
ARCHIVE_LLM_NUM_PREDICT=512
