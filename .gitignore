# =========================================================================
#  Local AI Search Engine — .gitignore
# =========================================================================

# --- Archive data: never commit ingested content, indexes, or models ---
# Ignore the CONTENTS of the data dirs but keep the directories themselves
# (via their .gitkeep placeholders) so the project structure is preserved.
# Uploaded / source documents (can be large, private, or copyrighted)
data/raw/*
!data/raw/.gitkeep
# ChromaDB persistent vector store
data/chroma/*
!data/chroma/.gitkeep
# BM25 / keyword index artifacts
data/keyword/*
!data/keyword/.gitkeep
# Persistent index manifest (derived state; rebuilt on demand)
data/index_manifest.json
data/index_manifest.json.tmp
# Any local model weights or GGUF files that get downloaded locally
*.gguf
*.bin
*.safetensors
models/

# --- Secrets & environment ---
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets/

# =========================================================================
#  Python (backend)
# =========================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# =========================================================================
#  Node / Next.js (frontend)
# =========================================================================
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# =========================================================================
#  OS / Editor cruft
# =========================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
*.swp
*.swo
*~

# Keep .vscode out by default, but allow shared settings if added explicitly
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# --- Logs ---
*.log
logs/
